generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Autor {
  id           Int    @id @default(autoincrement())
  nombre       String @unique  
  nacionalidad String
}

model Libro {
  id          Int     @id @default(autoincrement())
  titulo      String
  autor       String 
  descripcion String 
  precio      Int
  portada     String  
}
