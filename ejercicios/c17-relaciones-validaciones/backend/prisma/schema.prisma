generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Autor {
  id           Int    @id @default(autoincrement())
  nombre       String @unique  
  nacionalidad String
  libros       Libro[] @relation("LibroAutor", onDelete: Cascade)
}

model Libro {
  id          Int     @id @default(autoincrement())
  titulo      String
  autorId     Int     
  autor       Autor   @relation("LibroAutor", fields: [autorId], references: [id], onDelete: Restrict)
  descripcion String  
  precio      Int
  portada     String  
}
